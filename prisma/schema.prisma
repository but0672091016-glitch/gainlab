generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SyncRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  eyebrow     String?
  description String?
  imageUrl    String?
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  sections    CatalogSection[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CatalogSection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId, position])
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String            @id @default(cuid())
  sku              String            @unique
  slug             String            @unique
  name             String
  description      String?
  packageLabel     String?
  optionLabel      String?
  price            Decimal           @db.Decimal(12, 2)
  oldPrice         Decimal?          @db.Decimal(12, 2)
  stock            Int               @default(0)
  status           ProductStatus     @default(DRAFT)
  isDemo           Boolean           @default(true)
  isFeatured       Boolean           @default(false)
  isRecommended    Boolean           @default(false)
  isNew            Boolean           @default(false)
  artLabel         String?
  artTone          String             @default("silver")
  categoryId       String
  sectionId        String
  brandId          String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  section          CatalogSection    @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  brand            Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  variants         ProductVariant[]
  supplierProducts SupplierProduct[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([categoryId, status])
  @@index([sectionId, status])
  @@index([brandId, status])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id         String  @id @default(cuid())
  sku        String  @unique
  name       String
  value      String
  priceDelta Decimal @default(0) @db.Decimal(12, 2)
  stock      Int     @default(0)
  position   Int     @default(0)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  isDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id          String            @id @default(cuid())
  name        String            @unique
  code        String            @unique
  feedUrl     String?
  isActive    Boolean           @default(false)
  products    SupplierProduct[]
  syncRuns    SyncRun[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model SupplierProduct {
  id           String   @id @default(cuid())
  externalId   String
  supplierSku  String?
  productId    String
  supplierId   String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([supplierId, externalId])
  @@index([productId])
}

model SyncRun {
  id          String        @id @default(cuid())
  supplierId  String
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status      SyncRunStatus @default(PENDING)
  startedAt   DateTime?
  finishedAt  DateTime?
  processed   Int           @default(0)
  changed     Int           @default(0)
  errorMessage String?
  createdAt   DateTime      @default(now())

  @@index([supplierId, createdAt])
}
