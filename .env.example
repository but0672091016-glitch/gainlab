# Локальные тестовые значения. Не копируйте их в настройки хостинга.
# Текущая публичная демоверсия работает без PostgreSQL и без этих переменных.
POSTGRES_USER=gainlab
POSTGRES_PASSWORD=gainlab_local_password
POSTGRES_DB=gainlab
DATABASE_URL=postgresql://gainlab:gainlab_local_password@localhost:5432/gainlab?schema=public
# После публикации можно заменить на фактический HTTPS-адрес сайта.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
