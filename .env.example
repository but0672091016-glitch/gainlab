# Локальные тестовые значения. Не копируйте их в настройки хостинга.
# Без DATABASE_URL/NETLIFY_DB_URL сайт использует встроенный демо-каталог. При наличии строки подключения каталог читается из PostgreSQL.
POSTGRES_USER=gainlab
POSTGRES_PASSWORD=gainlab_local_password
POSTGRES_DB=gainlab
DATABASE_URL=postgresql://gainlab:gainlab_local_password@localhost:5432/gainlab?schema=public
# NETLIFY_DB_URL создаётся и хранится самой платформой Netlify Database; не добавляйте реальное значение в этот файл.
# После публикации можно заменить на фактический HTTPS-адрес сайта.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
